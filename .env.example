# Pipedrive CRM Configuration (REQUIRED)
# This is the primary data store for all waitlist signups
# Get your API token from: Settings → Personal → API
# Documentation: https://developers.pipedrive.com/docs/api/v1
PIPEDRIVE_API_TOKEN="your_pipedrive_api_token_here"

# Pipedrive Custom Fields (OPTIONAL - for structured data filtering)
# These allow you to filter and report on leads using Pipedrive's native filters
# Without these, all data is still stored in the note, but won't be filterable
#
# To get field keys:
# 1. Go to Settings → Data fields → Leads (or Persons)
# 2. Create custom fields (text/dropdown type)
# 3. Click on the field to see its key (format: abc123def456)
# 4. Copy the key and paste it here
#
# Recommended Lead custom fields:
# PIPEDRIVE_ROLE_FIELD_KEY=""           # Single option field (Agency, Creator, etc.)
# PIPEDRIVE_COHORT_FIELD_KEY=""         # Text field (stores YYYY-MM format)
# PIPEDRIVE_SOURCE_FIELD_KEY=""         # Text field (stores "Landing Page - Social Media Planner")
# PIPEDRIVE_TAGS_FIELD_KEY=""           # Text field (stores comma-separated tags)
#
# Recommended Person custom field:
# PIPEDRIVE_LINKEDIN_FIELD_KEY=""       # Text field (stores LinkedIn URL)


# Redis for Rate Limiting (OPTIONAL - but recommended for production)
# If not configured, rate limiting will be skipped (useful for local testing)

# Option 1: Railway Redis (recommended for production on Railway)
# REDIS_URL will be auto-set by Railway when you add Redis service
# No manual configuration needed!

# Option 2: Upstash Redis (for local dev or other hosting)
# Sign up at https://console.upstash.com (free tier: 10K requests/day)
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# If neither is set, you'll see a warning in console but the app will work fine
